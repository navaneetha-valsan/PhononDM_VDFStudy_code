Notebook[{
Cell["\<\
Reader note: This notebook checks whether the empirical velocity distribution \
can produce a finite v0_EMP when rms-matched to that of a truncated \
Maxwell-Boltzmann distribution.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.994339645344548*^9, 3.9943396550428953`*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"0537d88b-12a2-463f-86f2-485c33da7405"],

Cell["\<\
Workflow: for each (v0, vesc) point in Maxwell-Boltzmann distribution, \
compare vrms(MB) with that of the empirical distribution in v0 -> infinity \
limit at the same vesc and p=1.5. 
If vrms(MB) is larger than that limit, no finite v0_EMP solution exists and \
the point should be marked as v0_EMP = infinity on Fig. 1 (contour plot) in \
2606.04091v1.
Use the output from this notebook (output_contour.xlsx) in \
script_rms_contour_plot.ipynb\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.994339713535376*^9, 3.994339816974496*^9}, {
  3.994339891862475*^9, 3.99434003030504*^9}, {3.994340147429141*^9, 
  3.9943401507931747`*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"6d3c43a7-394d-405c-bace-3bb3574cf0d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Velocity", " ", "points", " ", "for", " ", "trials"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"v0vals", "=", 
     RowBox[{"{", 
      RowBox[{"220", ",", "200", ",", "280"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vescvals", "=", 
     RowBox[{"{", 
      RowBox[{"544", ",", "450", ",", "600"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Dense", " ", "velocity", " ", "grid", " ", "for", " ", "the", " ", 
     "plot"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"v0vals", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"200", ",", "280", ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vescvals", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"450", ",", "600", ",", "1"}], "]"}]}], ";"}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.982865421916986*^9, 3.982865432878707*^9}, {
   3.982865966223132*^9, 3.982865969021686*^9}, {3.982866258077988*^9, 
   3.982866260362779*^9}, {3.982877040511108*^9, 3.982877062549403*^9}, 
   3.98287717744258*^9, {3.9943402797305727`*^9, 3.994340368137735*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"8f932bf8-8f3b-4264-8722-1ad72b8ef34a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Maxwell", " ", "Boltzmann", " ", "Distribution", " ", "truncated", " ", 
     "at", " ", "v"}], "=", "vesc"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"kMB", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"4", "*", "Pi", "*", 
        SuperscriptBox["v", "2"], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["v", "2"]}], "/", 
          SuperscriptBox["v0", "2"]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "vesc"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{"v0", ">", "0"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valMB", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"4", "*", "Pi", "*", 
        SuperscriptBox["v", "4"], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["v", "2"]}], "/", 
          SuperscriptBox["v0", "2"]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "vesc"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{"v0", ">", "0"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vrmsMB", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"vrms", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"valMB", "/", "kMB"}], "]"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.968843405293565*^9, 3.968843496475761*^9}, {
   3.968843665823382*^9, 3.96884366939392*^9}, {3.968843716326255*^9, 
   3.9688437356719847`*^9}, {3.968850793100791*^9, 3.968850802868058*^9}, {
   3.968864215349628*^9, 3.968864231085552*^9}, {3.968864389841336*^9, 
   3.968864400829237*^9}, {3.968864588360602*^9, 3.968864595521482*^9}, {
   3.9688652044199953`*^9, 3.968865216431632*^9}, 3.968865619052636*^9, 
   3.968868006031762*^9, 3.968868101558982*^9, 3.968868132841525*^9, {
   3.982590483342021*^9, 3.982590506868041*^9}, 3.982590823342938*^9, 
   3.982590914978717*^9, {3.98259391804462*^9, 3.982593998382781*^9}, {
   3.982594076152687*^9, 3.98259407999143*^9}, {3.982598397730393*^9, 
   3.982598399869461*^9}, {3.982598654699253*^9, 3.9825986742627087`*^9}, {
   3.982669018784878*^9, 3.982669030600265*^9}, {3.9826720561200867`*^9, 
   3.9826720582016993`*^9}, {3.982865290109069*^9, 3.982865309769101*^9}, {
   3.982865416267602*^9, 3.982865417134921*^9}, {3.982865453827841*^9, 
   3.982865454221528*^9}, {3.982870602237989*^9, 3.9828706303719177`*^9}, {
   3.982875180008689*^9, 3.982875180844481*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"57bb9a75-9ae1-4c95-860b-0ffd2347c7b7"],

Cell["\<\
Empirical maximum block: this evaluates the empirical vrms in the v0 -> \
infinity limit for p = 1.5. That value is the largest vrms the empirical form \
can reach at fixed vesc.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9943402432931767`*^9, 3.994340256675775*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"da891911-8463-429c-9a13-fec68c214dd7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Empirical", " ", "distribution", " ", "Mao", " ", 
    RowBox[{"et", ".", "al"}], " ", "2013"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Find", " ", "vrmsmax", " ", "by", " ", "setting", " ", "v0"}], 
    "=", "inf"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"p", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kemp", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"4", "*", "Pi", "*", 
        SuperscriptBox["v", "2"], "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["vesc", "2"], "-", 
           SuperscriptBox["v", "2"]}], ")"}], "p"]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "vesc"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valemp", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"4", "*", "Pi", "*", 
        SuperscriptBox["v", "4"], "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["vesc", "2"], "-", 
           SuperscriptBox["v", "2"]}], ")"}], "p"]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "vesc"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vrmsmax", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"valemp", "/", "kemp"}], "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.968866174021675*^9, 3.96886619533605*^9}, {
   3.968867598080286*^9, 3.968867600013833*^9}, 3.968868028286962*^9, 
   3.968868120106973*^9, 3.968868151365719*^9, {3.970830559781701*^9, 
   3.9708305611827*^9}, {3.97083062192659*^9, 3.970830622415722*^9}, {
   3.970835247043646*^9, 3.970835247891064*^9}, 3.9708353276453457`*^9, {
   3.970837644163715*^9, 3.970837645013794*^9}, {3.982590918394485*^9, 
   3.982590922515936*^9}, {3.982865564019435*^9, 3.982865579015287*^9}, {
   3.982865620576934*^9, 3.982865621343403*^9}, {3.982865713043268*^9, 
   3.982865741527848*^9}, {3.994340129055478*^9, 3.994340215690002*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"b40dd582-ecd5-40fb-b7da-714715065f64"],

Cell["\<\
Comparison table: MB > max? is True when the Maxwell-Boltzmann vrms target \
exceeds that of the empirical in v0 -> infinity limit. 
Those True points are the no-finite-solution region used by \
script_rms_contour_plot.ipynb.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.994340408346714*^9, 3.994340445091364*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"7c69bcb8-ab6f-44d0-8462-ed50e5df61e1"],

