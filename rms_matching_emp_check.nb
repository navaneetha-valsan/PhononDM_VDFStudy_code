   RowBox[{"data", "=", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vrmsMBval", ",", "vrmsMaxVal"}], "}"}], ",", 
         RowBox[{
          RowBox[{"vrmsMBval", "=", 
           RowBox[{"N", "[", 
            RowBox[{"vrmsMB", "/.", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"vesc", "->", "vescval"}], ",", 
               RowBox[{"v0", "->", "v0val"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"vrmsMaxVal", "=", 
           RowBox[{"N", "[", 
            RowBox[{"vrmsmax", "/.", " ", 
             RowBox[{"{", 
              RowBox[{"vesc", "->", "vescval"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "v0val", ",", "vescval", ",", "vrmsMBval", ",", "vrmsMaxVal", ",", 
            
            RowBox[{"vrmsMBval", ">", "vrmsMaxVal"}]}], "   ", 
           RowBox[{"(*", 
            RowBox[{"True", "/", "False"}], "*)"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"vescval", ",", "vescvals"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v0val", ",", "v0vals"}], "}"}]}], "]"}], "//", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"#", ",", "1"}], "]"}], "&"}]}]}], ";"}], "\n", 
  RowBox[{"(*", 
