Cell["\<\
Empirical block: this derives the normalized rms expression for Empirical \
distribution (Mao et.al. 2013) with p fixed to 1.5. Then evaluates it on the \
same vesc and v0 grid used for the Maxwell-Boltzmann target.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.994338894738707*^9, 3.994338989880815*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"576921dd-9962-4c88-a402-bb1dfd427901"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Empirical", " ", "distribution"}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"p", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kemp", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"4", "*", "Pi", "*", 
        SuperscriptBox["v", "2"], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "v"}], "/", "v0"}], "]"}], "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["vesc", "2"], "-", 
           SuperscriptBox["v", "2"]}], ")"}], "p"]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "vesc"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{"v0", ">", "0"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valemp", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"4", "*", "Pi", "*", 
        SuperscriptBox["v", "4"], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "v"}], "/", "v0"}], "]"}], "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["vesc", "2"], "-", 
           SuperscriptBox["v", "2"]}], ")"}], "p"]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "vesc"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{"v0", ">", "0"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vrmsemp", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"valemp", "/", "kemp"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vescval", ",", "v0val", ",", 
            RowBox[{"N", "[", 
             RowBox[{"vrmsemp", "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"vesc", "->", "vescval"}], ",", 
                RowBox[{"v0", "->", "v0val"}]}], "}"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"vescval", ",", 
            RowBox[{"{", 
             RowBox[{"544", ",", "450", ",", "600"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v0val", ",", 
            RowBox[{"{", 
             RowBox[{"220", ",", "200", ",", "280"}], "}"}]}], "}"}]}], "]"}],
         "//", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"#", ",", "1"}], "]"}], "&"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<v_esc\>\"", ",", "\"\<v_0\>\"", ",", "\"\<vrms\>\""}], 
        "}"}]}], "\n", "]"}], ",", 
     RowBox[{"Frame", "->", "All"}], ",", 
     RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.968866174021675*^9, 3.96886619533605*^9}, {
   3.968867598080286*^9, 3.968867600013833*^9}, 3.968868028286962*^9, 
