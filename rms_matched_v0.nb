   3.986112925328138*^9, 3.986112967566597*^9}, {3.994338572206203*^9, 
   3.9943386082230377`*^9}, {3.994339207275323*^9, 3.994339337564907*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"57bb9a75-9ae1-4c95-860b-0ffd2347c7b7"],

