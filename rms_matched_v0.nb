Notebook[{
Cell["\<\
Reader note: This notebook derives the rms speed for a truncated \
Maxwell-Boltzmann distribution and uses that rms target to solve for the \
rms-matched Tsallis and empirical parameters, v0_TSA and v0_EMP.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9943387077584753`*^9, 3.9943387297815104`*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"291c9f03-c5d7-48e9-8d27-9d42800b2db6"],

Cell["\<\
Workflow: compute vrms(MB), build the Tsallis and empirical rms formulas, \
then use FindRoot to choose v0_TSA and v0_EMP so their rms values match the \
Maxwell-Boltzmann target. 
Use rms_matching_emp_check.nb to flag empirical cases with no finite v0_EMP \
solution.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{3.9943381277227488`*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"d136c003-f70c-4c4c-85a2-b98515304e60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Maxwell", " ", "Boltzmann", " ", "Distribution", " ", "truncated", " ", 
     "at", " ", "v"}], "=", "vesc"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"kMB", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"4", "*", "Pi", "*", 
        SuperscriptBox["v", "2"], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["v", "2"]}], "/", 
          SuperscriptBox["v0", "2"]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "vesc"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{"v0", ">", "0"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valMB", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"4", "*", "Pi", "*", 
        SuperscriptBox["v", "4"], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["v", "2"]}], "/", 
          SuperscriptBox["v0", "2"]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "vesc"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{"v0", ">", "0"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vrmsMB", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"vrms", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"valMB", "/", "kMB"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Conservative", " ", "range", " ", "for", " ", "velocity", " ", 
     "parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vescval", ",", "v0val", ",", 
          RowBox[{"N", "[", 
           RowBox[{"vrmsMB", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"vesc", "->", "vescval"}], ",", 
              RowBox[{"v0", "->", "v0val"}]}], "}"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"vescval", ",", 
          RowBox[{"{", 
           RowBox[{"544", ",", "450", ",", "600"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v0val", ",", 
          RowBox[{"{", 
           RowBox[{"220", ",", "200", ",", "280"}], "}"}]}], "}"}]}], "]"}], "//", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"#", ",", "1"}], "]"}], "&"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Aggressive", " ", "range", " ", "for", " ", "velocity", " ", 
     "parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"data", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vescval", ",", "v0val", ",", 
           RowBox[{"N", "[", 
            RowBox[{"vrmsMB", "/.", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"vesc", "->", "vescval"}], ",", 
               RowBox[{"v0", "->", "v0val"}]}], "}"}]}], "]"}]}], "}"}], ",", 
         
         RowBox[{"{", 
          RowBox[{"vescval", ",", 
           RowBox[{"{", 
            RowBox[{"528", ",", "503", ",", "552"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v0val", ",", 
           RowBox[{"{", 
            RowBox[{"238", ",", "236.5", ",", "239.5"}], "}"}]}], "}"}]}], 
        "]"}], "//", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "&"}]}]}], ";"}], "*)"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"triplets", ":", 
     RowBox[{"{", 
      RowBox[{"v_rms", ",", "v_esc", ",", "v0"}], "}"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"triples", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{"data", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<v_esc\>\"", ",", "\"\<v_0\>\"", ",", "\"\<vrms\>\""}], 
        "}"}]}], "]"}], ",", 
     RowBox[{"Frame", "->", "All"}], ",", 
     RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.968843405293565*^9, 3.968843496475761*^9}, {
   3.968843665823382*^9, 3.96884366939392*^9}, {3.968843716326255*^9, 
   3.9688437356719847`*^9}, {3.968850793100791*^9, 3.968850802868058*^9}, {
