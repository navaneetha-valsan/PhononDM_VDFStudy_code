Cell["\<\
Tsallis block: this derives the normalized Tsallis rms expression after \
substituting q = 1\[Dash]v0^2/vesc^2, then evaluates it on the same vesc and \
v0 grid used for the Maxwell-Boltzmann target.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.99433866236043*^9, 3.994338668745549*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"b7963e7f-e3ad-4ad8-b6bc-d0fa6b6969b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Tsallis", " ", "distribution"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "q"}], ")"}], " ", "=", " ", "qp"}], ",", " ", 
    RowBox[{"vesc", " ", "=", " ", 
     RowBox[{"v0", "/", 
      RowBox[{"sqrt", "[", "qp", "]"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ktsa", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"4", "*", "Pi", "*", 
        SuperscriptBox["v", "2"], "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"(", 
            RowBox[{"qp", "*", 
             RowBox[{
              SuperscriptBox["v", "2"], "/", 
              SuperscriptBox["v0", "2"]}]}], ")"}]}], ")"}], 
         RowBox[{"1", "/", "qp"}]]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", 
         RowBox[{"v0", "/", 
          SuperscriptBox[
           RowBox[{"(", "qp", ")"}], 
           RowBox[{"1", "/", "2"}]]}]}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"v0", ">", "0"}], ",", 
          RowBox[{"qp", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valtsa", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"4", "*", "Pi", "*", 
        SuperscriptBox["v", "4"], "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"(", 
            RowBox[{"qp", "*", 
             RowBox[{
              SuperscriptBox["v", "2"], "/", 
              SuperscriptBox["v0", "2"]}]}], ")"}]}], ")"}], 
         RowBox[{"1", "/", "qp"}]]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", 
         RowBox[{"v0", "/", 
          SuperscriptBox[
           RowBox[{"(", "qp", ")"}], 
           RowBox[{"1", "/", "2"}]]}]}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"qp", ">", "0"}], ",", 
          RowBox[{"v0", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vrmstsa", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"valtsa", "/", "ktsa"}], "]"}], " ", "/.", " ", 
        RowBox[{"qp", "->", 
         RowBox[{
          RowBox[{"v0", "^", "2"}], "/", 
          RowBox[{"vesc", "^", "2"}]}]}]}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"v0", ">", "0"}], ",", 
          RowBox[{"vesc", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"qpsub", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"v0val", "/", "vescval"}], ")"}], "^", "2"}]}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"vescval", ",", "v0val", ",", 
               RowBox[{"N", "[", 
                RowBox[{"vrmstsa", "/.", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"qp", "->", "qpsub"}], ",", 
                   RowBox[{"vesc", "->", "vescval"}], ",", 
                   RowBox[{"v0", "->", "v0val"}]}], "}"}]}], "]"}]}], "}"}]}],
             "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"vescval", ",", 
             RowBox[{"{", 
              RowBox[{"544", ",", "450", ",", "600"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"v0val", ",", 
             RowBox[{"{", 
              RowBox[{"220", ",", "200", ",", "280"}], "}"}]}], "}"}]}], 
          "]"}], ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<v_esc\>\"", ",", "\"\<v_0\>\"", ",", "\"\<vrms\>\""}], 
        "}"}]}], "]"}], ",", 
     RowBox[{"Frame", "->", "All"}], ",", 
     RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.968843777392271*^9, 3.968843827374*^9}, {
   3.968843859017148*^9, 3.96884391961795*^9}, {3.968848089395945*^9, 
   3.968848098948496*^9}, {3.968848273052485*^9, 3.968848283921825*^9}, {
